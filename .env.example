# Kode Platform — environment templates
#
# Professional layout (one template per APP_ENV):
#   .env.development.example  → local / loopback
#   .env.staging.example      → staging
#   .env.production.example   → production
#
# Runtime always loads a single gitignored file named `.env`:
#
#   cp .env.development.example .env
#
# Never commit `.env`. Never copy production secrets onto a laptop.

APP_ENV=development
NODE_ENV=development
