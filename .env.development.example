# Local development only. Matches docker-compose.yml.
# Never point these values at staging or production.

APP_ENV=development
NODE_ENV=development

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=kode_platform
DATABASE_USER=kode
DATABASE_PASSWORD=kode_dev_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=kode_dev
MINIO_SECRET_KEY=kode_dev_minio_password
MINIO_BUCKET=kode-dev

AUTH_TOKEN_SECRET=dev-only-kode-platform-access-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
