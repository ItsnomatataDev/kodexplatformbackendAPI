# Development template — copy to `.env` for local work:
#   cp .env.development.example .env
#
# APP_ENV must stay `development`. Hosts must be loopback.
# Replace commented optional secrets only when you need those features.

APP_ENV=development
NODE_ENV=development

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=kode_platform
DATABASE_USER=kode
DATABASE_PASSWORD=kode_dev_password
DATABASE_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=kode_dev
MINIO_SECRET_KEY=kode_dev_minio_password
MINIO_BUCKET=kode-dev

AUTH_TOKEN_SECRET=dev-only-kode-platform-access-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Optional Control Room host disk overrides (when API cannot read df):
# HOST_DISK_USED_BYTES=
# HOST_DISK_TOTAL_BYTES=

# KODEX — OpenAI-compatible LLM (company gateway preferred):
# LLM_BASE_URL=https://llm.internal/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_CHAT_MINI_MODEL=gpt-4o-mini
# Cutover fallback:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Cursor Agents / SDK only (crsr_…). Not used by KODEX chat/vision.
# CURSOR_API_KEY=

# Optional. Only needed for Supabase → MinIO media migration scripts.
# LEGACY_STORAGE_URL=https://your-project.supabase.co
# LEGACY_STORAGE_SERVICE_ROLE_KEY=

# Transactional email (Resend SMTP: host smtp.resend.com, user resend, password=API key)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# LiveKit (meetings) — must match the LiveKit server keys
# LIVEKIT_URL=wss://meet.itsnomatata.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Staff portal origin for password-reset email links
# APP_PUBLIC_URL=http://127.0.0.1:5173

MAX_ATTACHMENT_BYTES=10485760
CONTENT_STUDIO_MAX_UPLOAD_BYTES=1073741824
MAX_REQUEST_BODY_BYTES=16777216
WORK_MUTATION_RATE_LIMIT=60
WORK_ORG_MUTATION_RATE_LIMIT=180
WORK_IP_MUTATION_RATE_LIMIT=120
WORK_MUTATION_RATE_WINDOW_SECONDS=60
WORK_ATTACHMENT_RATE_LIMIT=10
WORK_ORG_ATTACHMENT_RATE_LIMIT=30
WORK_IP_ATTACHMENT_RATE_LIMIT=20
WORK_ATTACHMENT_RATE_WINDOW_SECONDS=60
