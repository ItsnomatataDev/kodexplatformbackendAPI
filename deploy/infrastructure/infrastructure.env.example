# Separate from .env.vps. Disabled until separately reviewed. No real secrets in this file.
INFRA_ENABLED=false
INFRA_ORIGIN=https://reviewed-frontend.example.invalid
INFRA_ORGANIZATION_ID=replace-with-explicit-organization-uuid
INFRA_DATABASE_URL=postgresql://restricted-infrastructure-login:REPLACE@approved-db-host/infrastructure_db
INFRA_HOST=127.0.0.1
INFRA_PORT=3101
INFRA_MFA_ACTIVE_KEY=v1
INFRA_TOKEN_KEY_FILE=/approved/secret/path/token-key
INFRA_MFA_KEYS_FILE=/approved/secret/path/mfa-keyring.json
# Alternate local-only secret injection: INFRA_TOKEN_KEY and INFRA_MFA_KEYS (never VITE_*).
INFRA_IDLE_SECONDS=900
INFRA_ABSOLUTE_SECONDS=28800
INFRA_FRESH_SECONDS=300
# Exact peer IPs only. Proxy must overwrite X-Infra-Client-IP. Blank trusts no forwarding headers.
INFRA_TRUSTED_PROXY_IPS=
# Local development only; forces HTTP listener to 127.0.0.1 and uses distinct dev cookies.
INFRA_LOCAL_HTTP=false
# Operator CLI uses provisioning.env.example instead; never share this runtime key environment.
