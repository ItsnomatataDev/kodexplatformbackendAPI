# Controlled operator process only. Use an individual restricted DB login for each operator.
# DO NOT source the HTTP runtime environment or mount its MFA/session key files here.
INFRA_PROVISION_DATABASE_URL=postgresql://individual-provisioner:REPLACE@approved-db-host/infrastructure_db
INFRA_ORGANIZATION_ID=replace-with-explicit-organization-uuid
INFRA_OPERATOR=accountable-operator-identity
# This identity may reset enrollment (powerful, out-of-band approval required), but cannot
# read encrypted MFA material, change passwords directly or mint sessions.
