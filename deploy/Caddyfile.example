# Example reverse-proxy configuration. This file does not enable live HTTPS
# by itself. Replace the domain via KODE_API_DOMAIN.
#
# Internet
#   → this proxy (HTTPS)
#     → kode API on the private network
#
# The proxy address must be listed in TRUSTED_PROXY_IPS.
# Do not trust X-Forwarded-For from arbitrary internet clients.

{$KODE_API_DOMAIN:api.example.invalid} {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# Camera / original videos can be hundreds of MiB–1 GiB and take a long time
	# on mobile or Starlink uplinks. Keep binary upload routes ungzip'd and with
	# long read timeouts so the proxy does not kill the stream mid-transfer.
	@contentStudioBinary path /api/content-studio/schedules/*/assets/binary /api/content-studio/clients/*/media/binary /api/stock/assets/*/images/*/binary
	handle @contentStudioBinary {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 60m
				write_timeout 60m
			}
		}
	}

	handle {
		encode gzip
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
