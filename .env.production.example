# Production environment.
# The process will not start unless ALLOW_PRODUCTION=true.
# Hosts must not be loopback. Names and buckets must identify production.
# TLS is required for PostgreSQL, Redis, and MinIO.
# Do not put real credentials in this file.

APP_ENV=production
NODE_ENV=production

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

ALLOW_PRODUCTION=false

DATABASE_HOST=production-postgres
DATABASE_PORT=5432
DATABASE_NAME=kode_platform_production
DATABASE_USER=kode_production
DATABASE_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
DATABASE_SSL=true
# DATABASE_SSL_CA_FILE=/run/secrets/postgres-ca.pem

REDIS_HOST=production-redis
REDIS_PORT=6379
REDIS_TLS=true
REDIS_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
# REDIS_USERNAME=
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.pem

MINIO_ENDPOINT=https://production-minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_RUNTIME_SECRET
MINIO_SECRET_KEY=REPLACE_WITH_RUNTIME_SECRET
MINIO_BUCKET=kode-production
# MINIO_TLS_CA_FILE=/run/secrets/minio-ca.pem

AUTH_TOKEN_SECRET=REPLACE_WITH_RUNTIME_SECRET_AT_LEAST_32_CHARS
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Production cannot start without a real mail provider.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=REPLACE_WITH_RUNTIME_SECRET
SMTP_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
SMTP_FROM=noreply@kode.example

CORS_ALLOWED_ORIGINS=https://app.kode.example

# Reverse proxy addresses only. Never 0.0.0.0/0.
TRUSTED_PROXY_IPS=10.0.0.1

# Binary attachment limit. JSON Base64 is ~4/3 this size plus ~1KiB envelope,
# so MAX_REQUEST_BODY_BYTES must be at least Base64(MAX_ATTACHMENT_BYTES)+1024.
MAX_ATTACHMENT_BYTES=10485760
MAX_REQUEST_BODY_BYTES=16777216

WORK_MUTATION_RATE_LIMIT=60
WORK_ORG_MUTATION_RATE_LIMIT=180
WORK_IP_MUTATION_RATE_LIMIT=120
WORK_MUTATION_RATE_WINDOW_SECONDS=60
WORK_ATTACHMENT_RATE_LIMIT=10
WORK_ORG_ATTACHMENT_RATE_LIMIT=30
WORK_IP_ATTACHMENT_RATE_LIMIT=20
WORK_ATTACHMENT_RATE_WINDOW_SECONDS=60
