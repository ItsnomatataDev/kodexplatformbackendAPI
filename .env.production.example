# Production template — copy to the production secret store / `.env` on the host only:
#   cp .env.production.example .env
#
# Replace every REPLACE_WITH_RUNTIME_SECRET before start.
# Requires ALLOW_PRODUCTION=true. Database name and MinIO bucket must contain `production`.

APP_ENV=production
NODE_ENV=production

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOW_PRODUCTION=true

DATABASE_HOST=production-postgres
DATABASE_PORT=5432
DATABASE_NAME=kode_platform_production
DATABASE_USER=kode_production
DATABASE_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
DATABASE_SSL=true

REDIS_HOST=production-redis
REDIS_PORT=6379
REDIS_TLS=true
REDIS_PASSWORD=REPLACE_WITH_RUNTIME_SECRET

MINIO_ENDPOINT=https://production-minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_RUNTIME_SECRET
MINIO_SECRET_KEY=REPLACE_WITH_RUNTIME_SECRET
MINIO_BUCKET=kode-production

# LLM_BASE_URL=https://llm.internal/v1
# LLM_API_KEY=REPLACE_WITH_RUNTIME_SECRET

AUTH_TOKEN_SECRET=REPLACE_WITH_RUNTIME_SECRET_AT_LEAST_32_CHARS
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Optional Control Room host disk overrides (when API cannot read df):
# HOST_DISK_USED_BYTES=
# HOST_DISK_TOTAL_BYTES=

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
SMTP_FROM=codex@itsnomatata.com

LIVEKIT_URL=wss://meet.itsnomatata.com
LIVEKIT_API_KEY=REPLACE_WITH_RUNTIME_SECRET
LIVEKIT_API_SECRET=REPLACE_WITH_RUNTIME_SECRET
APP_PUBLIC_URL=https://codex.itsnomatata.com

CORS_ALLOWED_ORIGINS=https://codex.itsnomatata.com,https://app.itsnomatata.com
TRUSTED_PROXY_IPS=10.0.0.1

MAX_ATTACHMENT_BYTES=10485760
CONTENT_STUDIO_MAX_UPLOAD_BYTES=1073741824
MAX_REQUEST_BODY_BYTES=16777216
WORK_MUTATION_RATE_LIMIT=60
WORK_ORG_MUTATION_RATE_LIMIT=180
WORK_IP_MUTATION_RATE_LIMIT=120
WORK_MUTATION_RATE_WINDOW_SECONDS=60
WORK_ATTACHMENT_RATE_LIMIT=10
WORK_ORG_ATTACHMENT_RATE_LIMIT=30
WORK_IP_ATTACHMENT_RATE_LIMIT=20
WORK_ATTACHMENT_RATE_WINDOW_SECONDS=60
