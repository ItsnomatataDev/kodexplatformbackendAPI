# Production environment.
# The process will not start unless ALLOW_PRODUCTION=true.
# Hosts must not be loopback. Names and buckets must identify production.

APP_ENV=production
NODE_ENV=production

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

ALLOW_PRODUCTION=false

DATABASE_HOST=production-postgres
DATABASE_PORT=5432
DATABASE_NAME=kode_platform_production
DATABASE_USER=kode_production
DATABASE_PASSWORD=change_me

REDIS_HOST=production-redis
REDIS_PORT=6379

MINIO_ENDPOINT=http://production-minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=kode-production

AUTH_TOKEN_SECRET=change_me_production_access_token_secret_32
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

CORS_ALLOWED_ORIGINS=https://app.kode.example
