# Isolated staging environment.
# Database name and MinIO bucket must identify staging.
# Never use production hosts, volumes, or credentials here.

APP_ENV=staging
NODE_ENV=staging

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_HOST=staging-postgres
DATABASE_PORT=5432
DATABASE_NAME=kode_platform_staging
DATABASE_USER=kode_staging
DATABASE_PASSWORD=change_me

REDIS_HOST=staging-redis
REDIS_PORT=6379

MINIO_ENDPOINT=http://staging-minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=kode-staging

AUTH_TOKEN_SECRET=change_me_staging_access_token_secret_32
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

CORS_ALLOWED_ORIGINS=https://staging.kode.example

# Only the reverse proxy addresses listed here may set X-Forwarded-For / X-Real-IP.
# Empty means the direct socket IP is used and forwarding headers are ignored.
TRUSTED_PROXY_IPS=10.0.0.1

# Binary attachment limit. JSON Base64 is ~4/3 this size plus ~1KiB envelope,
# so MAX_REQUEST_BODY_BYTES must be at least Base64(MAX_ATTACHMENT_BYTES)+1024.
MAX_ATTACHMENT_BYTES=10485760
MAX_REQUEST_BODY_BYTES=16777216

WORK_MUTATION_RATE_LIMIT=60
WORK_ORG_MUTATION_RATE_LIMIT=180
WORK_IP_MUTATION_RATE_LIMIT=120
WORK_MUTATION_RATE_WINDOW_SECONDS=60
WORK_ATTACHMENT_RATE_LIMIT=10
WORK_ORG_ATTACHMENT_RATE_LIMIT=30
WORK_IP_ATTACHMENT_RATE_LIMIT=20
WORK_ATTACHMENT_RATE_WINDOW_SECONDS=60

